  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            con.contypid AS \"domain_oid!\",\n            con.conname AS \"name!\",\n            pg_catalog.pg_get_constraintdef(con.oid, true) AS \"expression!\"\n        FROM pg_constraint con\n        WHERE con.contype = 'c'\n          AND con.contypid != 0\n        ORDER BY con.contypid, con.conname\n        ",
