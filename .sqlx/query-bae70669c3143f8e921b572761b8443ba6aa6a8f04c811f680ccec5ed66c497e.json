{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            cl.relname AS \"class_name!\",\n            d.objoid AS \"objoid!\",\n            d.objsubid AS \"objsubid!\",\n            d.description AS \"description!\"\n        FROM pg_description d\n        JOIN pg_class cl ON cl.oid = d.classoid\n        WHERE d.objoid >= 16384\n        ORDER BY cl.relname, d.objoid, d.objsubid\n        ",
