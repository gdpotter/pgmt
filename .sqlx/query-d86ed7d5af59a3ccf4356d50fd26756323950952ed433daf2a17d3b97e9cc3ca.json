  "query": "\n        SELECT\n            e.oid AS \"oid!\",\n            e.extname AS \"name!\",\n            e.extnamespace AS \"namespace!\",\n            e.extversion AS \"version!\",\n            e.extrelocatable AS \"relocatable!\",\n            ae.comment AS \"default_comment?\"\n        FROM pg_extension e\n        LEFT JOIN pg_available_extensions ae ON ae.name = e.extname\n        ORDER BY e.oid\n        ",
