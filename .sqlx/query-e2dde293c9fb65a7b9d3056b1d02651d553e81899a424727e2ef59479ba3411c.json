{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            cl.relname AS \"class_name!\",\n            dep.objid AS \"objid!\",\n            e.extname AS \"extension!\"\n        FROM pg_depend dep\n        JOIN pg_class cl ON cl.oid = dep.classid\n        JOIN pg_extension e ON e.oid = dep.refobjid\n        WHERE dep.deptype = 'e'\n          AND dep.refclassid = 'pg_extension'::regclass\n        ORDER BY cl.relname, dep.objid\n        ",
